# Shared Supabase project (same as icare_mc / icare_doctors / icaremc-admin).
# Copy to `.env.local` and fill in values from the admin `.env`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required to read admin payment settings (Chapa keys + fee %).
# Payment row RLS only allows authenticated users; service role bypasses that.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS OTP — same Betegna gateway as mc-app (POST /sms/send-otp, /sms/verify-otp).
SMS_API_BASE_URL=https://betegna-ai.vercel.app
# SMS_API_KEY=

# Optional Chapa overrides (normally read from app_settings id=payment in admin).
# CHAPA_PUBLIC_KEY=
# CHAPA_SECRET_KEY=
# CHAPA_FEE_PERCENT=2.5
# CHAPA_SANDBOX=true
