# Shared Supabase project (same as icare_mc / icare_doctors / admin).
# Copy to `.env.local` and fill in values from the admin `.env`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS OTP — same Betegna gateway as mc-app (POST /sms/send-otp, /sms/verify-otp).
SMS_API_BASE_URL=https://betegna-ai.vercel.app
# SMS_API_KEY=

# Optional: override Chapa keys. If unset, secret/public keys are read from
# app_settings id=payment (same source as admin Payment settings).
# CHAPA_SECRET_KEY=
# CHAPA_PUBLIC_KEY=
# CHAPA_FEE_PERCENT=2.5
# CHAPA_SANDBOX=true
